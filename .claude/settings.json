{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-tests.sh",
            "statusMessage": "Verificando guardrail de tests..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./.claude/hooks/correr-tests.sh",
            "statusMessage": "Corriendo la suite..."
          }
        ]
      }
    ]
  }
}
